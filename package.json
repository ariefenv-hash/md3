{
  "name": "android16-geek",
  "private": true,
  "version": "11.23.0",
  "type": "module",
  "scripts": {
    "start": "node scripts/serve.mjs",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "new-app": "node scripts/new-app.mjs",
    "check:dist": "node scripts/verify-dist.mjs",
    "e2e:dist": "node scripts/e2e-dist-smoke.mjs",
    "e2e:sweep": "node scripts/e2e-app-sweep.mjs",
    "e2e:pw": "playwright test",
    "sweep:write-baseline": "node scripts/e2e-app-sweep.mjs --write-baseline",
    "shot:diff": "node scripts/shot-baseline.mjs",
    "check:comments": "node scripts/check-comment-claims.mjs",
    "check:workflows": "node scripts/check-workflows.mjs",
    "check:version": "node scripts/audit-version-consumers.mjs",
    "version:sync": "node scripts/sync-readme-version.mjs",
    "deploy:gh": "gh-pages -d dist -t true",
    "claim": "node scripts/claim-registry.mjs",
    "audit:app": "node scripts/audit-app-quality.mjs",
    "check:motion": "node scripts/check-motion-tokens.mjs --check",
    "check:manifest": "node scripts/audit-manifest-icons.mjs",
    "check:dist-parity": "node scripts/check-dist-parity.mjs",
    "check:docs-index": "node scripts/audit-docs-index.mjs",
    "check:apps-doc": "node scripts/gen-apps-doc.mjs --check",
    "check:keymap": "node scripts/gen-keymap-doc.mjs --check",
    "triage:missing": "node scripts/missing-refs-triage.mjs --write"
  },
  "devDependencies": {
    "gh-pages": "^6.3.0",
    "happy-dom": "^20.14.5",
    "html-minifier-terser": "^7.2.0",
    "playwright": "^1.64.1",
    "typescript": "^7.0.2",
    "vite": "^7.1.0",
    "vitest": "^3.2.7"
  },
  "dependencies": {
    "@material-symbols/svg-400": "^0.48.0"
  }
}
